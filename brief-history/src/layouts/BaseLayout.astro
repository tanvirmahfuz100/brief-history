---
export interface Props {
  title?: string;
}

import '../styles/global.css';

const { title } = Astro.props;
const siteTitle = 'A Brief History of Past Questions';
const pageTitle = title ? `${title} — ${siteTitle}` : siteTitle;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>

    <header class="site-header">
      <div class="bar">
        <a class="brand" href="/brief-history/">
          <img src="/brief-history/logo.png" alt="Brief History logo" width="24" height="24" loading="eager" />
          <span>Brief History</span>
        </a>

        <nav class="main-nav">
          <a href="/brief-history/browse/">Browse</a>
          <a href="/brief-history/tools/">Tools</a>
          <a href="/brief-history/report/">Report</a>
        </nav>

        <button class="menu-toggle" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
          <svg viewBox="0 0 20 20" aria-hidden="true" style="color: #ffffff; width: 20px; height: 20px; display: block;">
            <line x1="3" y1="7" x2="17" y2="7" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
            <line x1="3" y1="10" x2="17" y2="10" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
            <line x1="3" y1="13" x2="17" y2="13" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          </svg>
        </button>
      </div>

      <div class="mobile-menu" id="mobile-menu">
        <a href="/brief-history/browse/">Browse</a>
        <a href="/brief-history/tools/">Tools</a>
        <a href="/brief-history/report/">Report</a>
      </div>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="inner">
        <p>Department of Accounting &amp; Information Systems, University of Barishal.</p>
        <p>A Brief History of Past Questions &mdash; public, login-free archive.</p>
      </div>
    </footer>

    <script>
      (function () {
        var btn = document.querySelector('.menu-toggle');
        var menu = document.getElementById('mobile-menu');
        if (!btn || !menu) return;
        btn.addEventListener('click', function () {
          var open = menu.classList.contains('open');
          btn.setAttribute('aria-expanded', String(!open));
          menu.classList.toggle('open');
        });
      })();
    </script>
  </body>
</html>
