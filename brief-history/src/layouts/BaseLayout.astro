---
export interface Props {
  title?: string;
}

const { title } = Astro.props;
const siteTitle = 'A Brief History of Past Questions';
const pageTitle = title ? `${title} — ${siteTitle}` : siteTitle;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>

    <header>
      <div class="bar">
        <a class="brand" href="/brief-history/">
          <img src="/brief-history/logo.png" alt="Brief History logo" width="24" height="24" loading="eager" />
          Brief History
        </a>

        <nav>
          <a href="/brief-history/browse/">Browse</a>
          <a href="/brief-history/tools/">Tools</a>
          <a href="/brief-history/report/">Report</a>
        </nav>

        <button class="menu-toggle" aria-label="Open menu" aria-expanded="false">
          <svg viewBox="0 0 20 20" aria-hidden="true">
            <line x1="3" y1="7" x2="17" y2="7" />
            <line x1="3" y1="10" x2="17" y2="10" />
            <line x1="3" y1="13" x2="17" y2="13" />
          </svg>
        </button>
      </div>

      <div class="mobile-menu" id="mobile-menu">
        <a href="/brief-history/browse/">Browse</a>
        <a href="/brief-history/tools/">Tools</a>
        <a href="/brief-history/report/">Report</a>
      </div>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <footer>
      <div class="inner">
        <p>Department of Accounting &amp; Information Systems, University of Barishal.</p>
        <p>A Brief History of Past Questions &mdash; public, login-free archive.</p>
      </div>
    </footer>
  </body>
</html>
