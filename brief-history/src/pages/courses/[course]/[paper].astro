---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { courseSlug } from '@/lib/slug';

export async function getStaticPaths() {
  const questions = await getCollection('questions');
  return questions.map(q => ({
    params: { course: courseSlug(q.data.course_code), paper: q.id },
    props: { q },
  }));
}

const { q } = Astro.props;
const { Content } = await render(q);

const provenance = [
  q.data.source_file ? `Source file: ${q.data.source_file}` : null,
  q.data.source_id ? `Source id: ${q.data.source_id}` : null,
  q.data.pages.length ? `Pages: ${q.data.pages.join(', ')}` : null,
  q.data.university ? `University: ${q.data.university}` : null,
  q.data.department ? `Department: ${q.data.department}` : null,
].filter(Boolean);
---

<BaseLayout title={q.data.course}>
  <div class="container section paper-body">
    <h1 class="paper-title">{q.data.course}</h1>
    <p class="paper-meta">
      <b>{q.data.course_code}</b>
      <span>&bull;</span>
      {q.data.session}
      <span>&bull;</span>
      {q.data.exam}
      {q.data.year_semester ? <span>&bull;</span> <span>{q.data.year_semester}</span> : null}
      {q.data.full_marks ? <span>&bull;</span> <span>Full marks: {q.data.full_marks}</span> : null}
      {q.data.time ? <span>&bull;</span> <span>Time: {q.data.time}</span> : null}
    </p>

    {provenance.length ? (
      <dl class="provenance-list">
        {provenance.map((p) => {
          const [k, ...v] = p.split(': ');
          return (
            <>
              <dt>{k}</dt>
              <dd>{v.join(': ')}</dd>
            </>
          );
        })}
      </dl>
    ) : null}

    {q.data.instructions ? (
      <details>
        <summary>Instructions</summary>
        <p>{q.data.instructions}</p>
      </details>
    ) : null}

    {q.data.choice ? (
      <details>
        <summary>Choice</summary>
        <p>{q.data.choice}</p>
      </details>
    ) : null}

    {q.data.ocr_confidence || q.data.notes ? (
      <div class="confidence-notice">
        {q.data.ocr_confidence ? <p>OCR confidence: {q.data.ocr_confidence}</p> : null}
        {q.data.notes ? <p>Transcription note: {q.data.notes}</p> : null}
      </div>
    ) : null}

    <Content />

    {q.data.references && q.data.references.length ? (
      <section class="cross-refs" aria-label="Cross references">
        {q.data.references.map((ref) => (
          <p class="marginal-note" key={ref.paper}>
            <span class="note-label">Compare with:</span>{' '}
            {ref.note ?? ref.question ?? ref.paper}
          </p>
        ))}
      </section>
    ) : null}

    <nav class="back-links">
      <a href={`/brief-history/courses/${courseSlug(q.data.course_code)}/`}>&larr; Back to {q.data.course_code.toUpperCase()}</a>
      <a href="/brief-history/browse/">&larr; Back to browse</a>
      <a href="/brief-history/">&larr; Home</a>
    </nav>
  </div>
</BaseLayout>
