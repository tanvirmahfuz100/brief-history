---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { courseSlug, slug } from '@/lib/slug';

export async function getStaticPaths() {
  const questions = await getCollection('questions');
  const codes = [...new Set(questions.map(q => q.data.course_code))];
  return codes.map(code => ({
    params: { course: courseSlug(code) },
    props: { code },
  }));
}

const { code } = Astro.props;
const questions = (await getCollection('questions')).filter(q => q.data.course_code === code);

const numericCode = code.match(/\d+/)?.[0] ?? '';
const logoPath = `/logos/${numericCode}.svg`;
const syllabi = await getCollection('syllabi');
const syllabus = numericCode ? syllabi.find(s => s.data.code === numericCode) : undefined;
const SyllabusContent = syllabus ? (await render(syllabus)).Content : undefined;

const grouped = new Map();
for (const q of questions) {
  const session = q.data.session || 'unknown';
  const exam = q.data.exam || 'unknown';
  if (!grouped.has(session)) grouped.set(session, new Map());
  if (!grouped.get(session).has(exam)) grouped.get(session).set(exam, []);
  grouped.get(session).get(exam).push(q);
}
const sessions = [...grouped.entries()].sort((a, b) => a[0].localeCompare(b[0]));
---

<BaseLayout title={code}>
  <div class="container section">
    <nav class="course-nav">
      <a href="/brief-history/browse/">Browse</a>
      <span aria-hidden="true">/</span>
      <span>{code.toUpperCase()}</span>
    </nav>

    <div class="course-logo">
      <img src={logoPath} alt={`Course ${numericCode}`} width="120" height="120" />
    </div>

    <h1 class="course-title">{code.toUpperCase()} &mdash; {questions.length > 0 ? questions[0].data.course : code}</h1>

    {syllabus ? (
      <section class="syllabus-topics">
        <h2>Syllabus topics</h2>
        <SyllabusContent />
      </section>
    ) : null}

    <section class="papers-section">
      <h2>Past questions ({questions.length})</h2>
      <div class="papers-list">
        {sessions.map(([session, exams]) => (
          <section class="session-block" id={`session-${slug(session)}`}>
            <h3 class="session-label">{session}</h3>
            {[...exams.entries()].sort(([a], [b]) => a.localeCompare(b)).map(([exam, items]) => (
              <div class="course-exam">
                <h4>{exam}</h4>
                <ul>
                  {items.map((q) => (
                    <li class="question-card" key={q.id}>
                      <a href={`/brief-history/courses/${courseSlug(code)}/${q.id}/`} class="paper-link">
                        {q.data.course} &mdash; {q.data.exam}
                      </a>
                      <p class="question-meta">
                        <b>{q.data.year_semester}</b>
                        <span>&bull;</span>
                        {q.data.full_marks ? <span>{q.data.full_marks} marks</span> : null}
                        <span>&bull;</span>
                        {q.data.session}
                        {q.data.ocr_confidence ? <span>&bull; OCR {q.data.ocr_confidence}</span> : null}
                      </p>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </section>
        ))}
      </div>
    </section>

    <p class="back-links">
      <a href="/brief-history/browse/">&larr; Back to browse</a>
    </p>
  </div>
</BaseLayout>
