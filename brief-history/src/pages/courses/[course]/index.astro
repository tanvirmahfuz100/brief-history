---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { courseSlug } from '@/lib/slug';

export async function getStaticPaths() {
  const questions = await getCollection('questions');
  const codes = [...new Set(questions.map(q => q.data.course_code))];
  return codes.map(code => ({
    params: { course: courseSlug(code) },
    props: { code },
  }));
}

const { code } = Astro.props;
const questions = (await getCollection('questions')).filter(q => q.data.course_code === code);

// Group papers by academic session, then by exam type, for a readable index.
const grouped = new Map();
for (const q of questions) {
  const session = q.data.session || 'unknown';
  const exam = q.data.exam || 'unknown';
  if (!grouped.has(session)) grouped.set(session, new Map());
  if (!grouped.get(session).has(exam)) grouped.get(session).set(exam, []);
  grouped.get(session).get(exam).push(q);
}
const sessions = [...grouped.entries()].sort((a, b) => a[0].localeCompare(b[0]));
---

<BaseLayout title={code}>
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <a href="/brief-history/">Home</a> › <a href="/brief-history/courses/">Courses</a> › <span>{code}</span>
  </nav>

  <section class="course-head">
    <h1>{code}</h1>
    <p class="muted">{questions.length} paper{questions.length === 1 ? '' : 's'} across {sessions.length} session{sessions.length === 1 ? '' : 's'}</p>
  </section>

  <section id="syllabus" class="syllabus" aria-label="Syllabus">
    <h2>Syllabus</h2>
    <p class="empty-state">Syllabus not available yet.</p>
  </section>

  <section id="papers" class="papers" aria-label="Past papers">
    <h2>Past papers</h2>
    {sessions.map(([session, exams]) => (
      <section class="session-block">
        <h3 class="session-label">{session}</h3>
        {[...exams.entries()].sort(([a], [b]) => a.localeCompare(b)).map(([exam, items]) => (
          <div class="exam-block">
            <h4 class="exam-label">{exam}</h4>
            <ul class="paper-list">
              {items.map(q => {
                const hasNotes = Boolean(q.data.notes);
                const confidence = q.data.ocr_confidence ? q.data.ocr_confidence : null;
                return (
                  <li class="paper-card">
                    <a class="paper-title" href={`/brief-history/courses/${courseSlug(code)}/${q.id}/`}>
                      {q.data.course}
                    </a>
                    <p class="paper-meta">
                      <span>{q.data.session}</span> · <span>{q.data.exam}</span>
                      {q.data.full_marks ? <> · <span>Full marks: {q.data.full_marks}</span></> : null}
                      {q.data.time ? <> · <span>Time: {q.data.time}</span></> : null}
                    </p>
                    <p class="paper-source">
                      Source: {q.data.source_file || 'unknown'} · Pages: {q.data.pages.length ? q.data.pages.join(', ') : 'unknown'}
                    </p>
                    {confidence ? <p class="paper-confidence">OCR confidence: {confidence}</p> : null}
                    {hasNotes ? <p class="paper-notes" role="note">Transcription note: {q.data.notes}</p> : null}
                  </li>
                );
              })}
            </ul>
          </div>
        ))}
      </section>
    ))}
  </section>

  <p class="back-links"><a href="/brief-history/courses/">← Back to courses</a></p>
</BaseLayout>
