---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { courseSlug } from '@/lib/slug';

const questions = await getCollection('questions');
const byCourse = new Map();
for (const q of questions) {
  const key = q.data.course_code;
  if (!byCourse.has(key)) byCourse.set(key, { code: key, title: q.data.course, department: q.data.department, count: 0 });
  byCourse.get(key).count++;
}
const courses = [...byCourse.values()].sort((a, b) => a.code.localeCompare(b.code));
const total = courses.length;
---

<BaseLayout title="Index">
  <div class="running-header">
    <span class="rh-left">A Brief History of Past Questions</span>
    <span class="rh-right">Index</span>
  </div>

  <section class="index-block" aria-labelledby="index-heading">
    <h2 id="index-heading">Index</h2>
    <hr class="double-rule" />
    <label class="index-label" for="course-filter">Look up in the Index</label>
    <input
      class="index-input"
      id="course-filter"
      type="search"
      placeholder="Course, topic or year&hellip;"
      aria-describedby="index-help"
    />
    <p id="index-help" class="no-results" aria-live="polite"></p>

    <nav class="toc" id="course-list">
      {courses.map((c) => (
        <a class="toc-line" href={`/brief-history/courses/${courseSlug(c.code)}/`}>
          <span class="toc-title">{c.code}</span>
          <span class="toc-leader" aria-hidden="true"></span>
          <span class="toc-page">{c.title}</span>
        </a>
      ))}
    </nav>
  </section>

  <p class="muted" style="margin-top:0;">{total} course{total === 1 ? '' : 's'} listed</p>

  <div class="back-links">
    <a href="/brief-history/">← Title page</a>
  </div>

  <script>
    const input = document.getElementById('course-filter');
    const empty = document.getElementById('index-help');
    const lines = document.querySelectorAll('#course-list .toc-line');
    const totalCount = lines.length;
    input.addEventListener('input', () => {
      const q = input.value.toLowerCase();
      let shown = 0;
      lines.forEach((li) => {
        const match = li.textContent.toLowerCase().includes(q);
        li.hidden = !match;
        if (match) shown += 1;
      });
      empty.hidden = shown !== 0 || q === '';
      empty.textContent = q && shown === 0 ? 'No courses match “' + input.value + '”.' : '';
      empty.classList.toggle('visible', q !== '' && shown === 0);
    });
  </script>
</BaseLayout>
