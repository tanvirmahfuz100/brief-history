---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { courseHref, courseInfoForKey, courseKey, formatCode, semesterGroups } from '@/lib/catalog';

const questions = await getCollection('questions');
const byKey = new Map<string, { code: string; title: string; semester: string; papers: number }>();
for (const q of questions) {
  const key = courseKey(q.data);
  const info = courseInfoForKey(key);
  if (!byKey.has(key)) {
    byKey.set(key, {
      code: info?.code ?? String(q.data.course_code ?? 'unknown'),
      title: info?.title ?? String(q.data.course ?? 'Unidentified paper'),
      semester: info?.semester ?? '',
      papers: 0,
    });
  }
  byKey.get(key)!.papers++;
}
const groups = semesterGroups([...byKey.values()].filter((course) => course.papers > 0));
---

<BaseLayout title="Courses">
  <div class="container section">
    <nav class="browse-nav" aria-label="Breadcrumb">
      <a href="/brief-history/">Home</a>
      <span aria-hidden="true">/</span>
      <span>Courses</span>
    </nav>
    <h1 class="browse-title">Courses with papers</h1>
    <p class="page-lede">Every course in the archive, grouped by semester. Open a course to see its papers and syllabus.</p>

    {groups.map((group) => (
      <section class="video-group">
        <h2 class="section-heading">{group.semester}</h2>
        <div class="course-video-grid">
          {group.items.map((course) => (
            <a class="course-video-card" href={courseHref({ course_code: course.code })}>
              <span class="course-video-code">{formatCode(course.code)}</span>
              <span class="course-video-title">{course.title}</span>
              <span class="course-video-meta">{course.papers} papers</span>
            </a>
          ))}
        </div>
      </section>
    ))}

    <p class="back-links"><a href="/brief-history/browse/">← Browse all papers</a></p>
  </div>
</BaseLayout>
