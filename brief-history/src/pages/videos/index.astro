---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { VIDEO_COURSES } from '@/data/videos.generated';
import { COURSE_BY_CODE, courseSemester, formatCode } from '@/lib/catalog';
import { courseSlug } from '@/lib/slug';

const questions = await getCollection('questions');
const paperCounts = new Map<string, number>();
for (const q of questions) {
  paperCounts.set(q.data.course_code, (paperCounts.get(q.data.course_code) ?? 0) + 1);
}

const courses = VIDEO_COURSES.map((video) => {
  const info = COURSE_BY_CODE.get(video.code);
  return {
    code: video.code,
    title: info?.title ?? video.guideTitle,
    semester: info?.semester ?? courseSemester(video.code),
    videos: video.videoCount,
    papers: paperCounts.get(video.code) ?? 0,
    slug: courseSlug(video.code),
  };
});

const semesters = [...new Set(courses.map((c) => c.semester))];
const grouped = semesters
  .sort()
  .map((semester) => ({ semester, items: courses.filter((c) => c.semester === semester) }));

const totalVideos = courses.reduce((sum, c) => sum + c.videos, 0);
---

<BaseLayout title="Video lessons">
  <div class="container section">
    <nav class="browse-nav" aria-label="Breadcrumb">
      <a href="/brief-history/">Home</a>
      <span aria-hidden="true">/</span>
      <span>Video lessons</span>
    </nav>

    <h1 class="browse-title">Video lessons</h1>
    <p class="page-lede">
      {totalVideos} third-party YouTube lessons mapped to the AIS syllabus across
      {courses.length} courses. Coverage is partial and page-level only; use your class
      materials as the exam authority.
    </p>

    {grouped.map((group) => (
      <section class="video-group" aria-labelledby={`semester-${group.semester}`}>
        <h2 class="section-heading" id={`semester-${group.semester}`}>{group.semester}</h2>
        <div class="course-video-grid">
          {group.items.map((course) => (
            <a class="course-video-card" href={`/brief-history/videos/${course.slug}/`}>
              <span class="course-video-code">{formatCode(course.code)}</span>
              <span class="course-video-title">{course.title}</span>
              <span class="course-video-meta">
                {course.videos} video lessons
                {course.papers > 0 ? ` · ${course.papers} past papers` : ''}
              </span>
            </a>
          ))}
        </div>
      </section>
    ))}

    <p class="back-links">
      <a href="/brief-history/browse/">← Browse past questions</a>
    </p>
  </div>
</BaseLayout>
