---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import {
  SEMESTER_ORDER,
  courseHref,
  courseInfoForKey,
  courseKey,
  formatCode,
  paperHref,
  semesterLogoPath,
  titleForPaper,
} from '@/lib/catalog';
import { VIDEO_COURSES } from '@/data/videos.generated';
import { courseSlug } from '@/lib/slug';
import { latestPosts } from '@/data/posts';

const questions = await getCollection('questions');
const paperCount = questions.length;
const courseKeys = [...new Set(questions.map((q) => courseKey(q.data)))];
const courseCount = courseKeys.length;
const semesterCount = SEMESTER_ORDER.length;

const semesterVolumes = SEMESTER_ORDER.map((semester, index) => {
  const papers = questions.filter((q) => courseInfoForKey(courseKey(q.data))?.semester === semester);
  return {
    label: semester,
    volume: semester.startsWith('MBA') ? 'MBA' : ['I', 'II', 'III', 'IV', 'V', 'VI', 'VII', 'VIII'][index],
    paperCount: papers.length,
    courseCount: new Set(papers.map((q) => courseKey(q.data))).size,
    logo: semesterLogoPath(semester),
  };
});

const yearGroups = [
  { label: '1st Year', volumes: semesterVolumes.filter((v) => v.label.startsWith('1st')) },
  { label: '2nd Year', volumes: semesterVolumes.filter((v) => v.label.startsWith('2nd')) },
  { label: '3rd Year', volumes: semesterVolumes.filter((v) => v.label.startsWith('3rd')) },
  { label: '4th Year', volumes: semesterVolumes.filter((v) => v.label.startsWith('4th')) },
  { label: 'MBA', volumes: semesterVolumes.filter((v) => v.label.startsWith('MBA')) },
];

const randomPaper = questions[Math.floor(Math.random() * questions.length)];

const paperCounts = new Map<string, number>();
for (const q of questions) {
  const key = courseKey(q.data);
  paperCounts.set(key, (paperCounts.get(key) ?? 0) + 1);
}
const topCourses = [...paperCounts.entries()]
  .sort(([, a], [, b]) => b - a)
  .slice(0, 5)
  .map(([key, count]) => {
    const info = courseInfoForKey(key);
    return { key, code: info?.code ?? key, title: info?.title ?? 'Unidentified paper', count };
  });

const newlyAdded = [...questions].sort((a, b) => b.id.localeCompare(a.id)).slice(0, 5);
const featuredVideos = [...VIDEO_COURSES].sort((a, b) => b.videoCount - a.videoCount).slice(0, 4);
const totalVideos = VIDEO_COURSES.reduce((sum, course) => sum + course.videoCount, 0);
const posts = latestPosts().slice(0, 2);
---

<BaseLayout title="Home">
  <section class="home-hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="hero-kicker">
          <img
            class="hero-project-mark"
            src="/brief-history/brand/readability-mark.png"
            alt=""
            width="28"
            height="28"
            loading="eager"
          />
          <span>A project of <span class="highlight">THEORY OF READABILITY</span></span>
        </p>
        <h1 class="home-title">A Brief History of <span>Past Questions</span></h1>
        <p class="home-subtitle">
          Every paper we can find, organized by semester and course for the students of the
          Department of Accounting &amp; Information Systems, University of Barishal.
        </p>

        <form class="search-form" action="/brief-history/browse/" method="GET">
          <label class="search-label" for="search">Search the archive</label>
          <div class="search-row">
            <input
              id="search"
              name="search"
              class="search-input"
              type="search"
              placeholder="Depreciation, bank reconciliation, AIS 1101…"
              required
            />
            <button type="submit" class="search-btn">Search <span aria-hidden="true">→</span></button>
          </div>
        </form>

        <div class="hero-stats" aria-label="Archive totals">
          <div><strong>{paperCount}</strong><span>papers</span></div>
          <div><strong>{courseCount}</strong><span>courses</span></div>
          <div><strong>{semesterCount}</strong><span>semesters</span></div>
          <div><strong>{totalVideos}</strong><span>video lessons</span></div>
        </div>
      </div>

      <div class="hero-emblem" aria-hidden="true">
        <div class="hero-frame">
          <img
            src="/brief-history/brand/brief-history-mark.png"
            alt=""
            width="640"
            height="640"
            loading="eager"
          />
          <span class="hero-frame-caption">Explore<br />the record</span>
        </div>
      </div>
    </div>
  </section>

  <div class="container section home-main">
    <section class="semesters" aria-labelledby="semesters-heading">
      <div class="section-head">
        <span class="section-index" aria-hidden="true">01</span>
        <h2 class="semester-heading" id="semesters-heading">Semesters</h2>
        <span class="section-rule" aria-hidden="true"></span>
      </div>
      <p class="section-lede">
        The archive follows the eight-semester BBA journey, plus the MBA programme. Empty
        semesters are shown so the record stays honest about what is still being collected.
      </p>

      <div class="semester-years">
        {yearGroups.map((year) => (
          <section class="year-group" aria-labelledby={`year-${year.label.toLowerCase().replace(/\s+/g, '-')}`}>
            <header class="year-head">
              <h3 class="year-heading" id={`year-${year.label.toLowerCase().replace(/\s+/g, '-')}`}>{year.label}</h3>
              <span class="year-meta">
                {year.volumes.length} {year.volumes.length === 1 ? 'semester' : 'semesters'}
              </span>
            </header>
            <div class="semester-grid">
              {year.volumes.map((v) =>
                v.paperCount > 0 ? (
                  <a
                    href={`/brief-history/browse/?semester=${encodeURIComponent(v.label)}`}
                    class="semester-card"
                    aria-label={`${v.label} — ${v.paperCount} papers across ${v.courseCount} courses`}
                  >
                    <span class="semester-cover">
                      <img src={v.logo} alt="" width="1000" height="1000" loading="lazy" />
                      <span class="semester-badge">{v.paperCount} papers</span>
                    </span>
                    <span class="semester-body">
                      <span class="semester-volume">{v.volume === 'MBA' ? 'MBA programme' : `Volume ${v.volume}`}</span>
                      <span class="semester-label">{v.label}</span>
                      <span class="semester-count">{v.courseCount} courses in archive</span>
                      <span class="semester-open">Open semester <span aria-hidden="true">→</span></span>
                    </span>
                  </a>
                ) : (
                  <div
                    class="semester-card is-empty"
                    aria-label={`${v.label} — no papers collected yet`}
                  >
                    <span class="semester-cover">
                      <img src={v.logo} alt="" width="1000" height="1000" loading="lazy" />
                      <span class="semester-badge is-empty">Collecting</span>
                    </span>
                    <span class="semester-body">
                      <span class="semester-volume">{v.volume === 'MBA' ? 'MBA programme' : `Volume ${v.volume}`}</span>
                      <span class="semester-label">{v.label}</span>
                      <span class="semester-count">No papers yet</span>
                      <span class="semester-open">Help us find these papers</span>
                    </span>
                  </div>
                ),
              )}
            </div>
          </section>
        ))}
      </div>
    </section>

    <section class="quick-actions" aria-labelledby="quick-actions-heading">
      <div class="section-head">
        <span class="section-index" aria-hidden="true">02</span>
        <h2 class="quick-actions-heading" id="quick-actions-heading">Quick actions</h2>
        <span class="section-rule" aria-hidden="true"></span>
      </div>
      <div class="quick-actions-grid">
        <a href={paperHref({ ...randomPaper.data, id: randomPaper.id })} class="quick-btn random-btn" aria-label="Open a random past question">
          <span class="quick-num" aria-hidden="true">01</span>
          <span class="quick-copy"><strong>Surprise me</strong><small>Open a random paper</small></span>
          <span class="quick-arrow" aria-hidden="true">→</span>
        </a>
        <a href="/brief-history/browse/" class="quick-btn browse-btn">
          <span class="quick-num" aria-hidden="true">02</span>
          <span class="quick-copy"><strong>Browse all</strong><small>Filter by course and semester</small></span>
          <span class="quick-arrow" aria-hidden="true">→</span>
        </a>
        <a href="/brief-history/tools/" class="quick-btn">
          <span class="quick-num" aria-hidden="true">03</span>
          <span class="quick-copy"><strong>Tools</strong><small>Study helpers and downloads</small></span>
          <span class="quick-arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </section>

    <section class="top-courses" aria-labelledby="top-heading">
      <div class="section-head">
        <span class="section-index" aria-hidden="true">03</span>
        <h2 class="top-heading" id="top-heading">Most papers</h2>
        <span class="section-rule" aria-hidden="true"></span>
      </div>
      <div class="top-list">
        {topCourses.map((course, index) => (
          <a href={courseHref({ course_code: course.code })} class="top-chip" aria-label={`${course.code} — ${course.count} papers`}>
            <span class="top-rank" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <span class="top-main">
              <span class="top-code">{formatCode(course.code)}</span>
              <span class="top-title">{course.title}</span>
            </span>
            <span class="top-count">{course.count} papers</span>
          </a>
        ))}
      </div>
    </section>

    <section class="newly-added" aria-labelledby="new-heading">
      <div class="section-head">
        <span class="section-index" aria-hidden="true">04</span>
        <h2 class="new-heading" id="new-heading">Newly added</h2>
        <span class="section-rule" aria-hidden="true"></span>
      </div>
      <ul class="new-list">
        {newlyAdded.map((q, index) => (
          <li class="new-item">
            <span class="new-index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <a href={paperHref({ ...q.data, id: q.id })}>{titleForPaper(q.data)}</a>
            <span class="new-meta">{formatCode(q.data.course_code)} &middot; {q.data.session}</span>
          </li>
        ))}
      </ul>
    </section>

    <section class="videos" aria-labelledby="videos-heading">
      <div class="section-head">
        <span class="section-index" aria-hidden="true">05</span>
        <h2 class="videos-heading" id="videos-heading">Video lessons</h2>
        <span class="section-rule" aria-hidden="true"></span>
      </div>
      <p class="videos-intro">
        {totalVideos} third-party YouTube lessons mapped to {VIDEO_COURSES.length} courses.
        These are supplements, not university lectures.
      </p>
      <div class="videos-grid">
        {featuredVideos.map((video) => {
          const info = courseInfoForKey(video.code);
          return (
            <a href={`/brief-history/videos/${courseSlug(video.code)}/`} class="video-card">
              <span class="video-top">
                <span class="video-badge suggestion">YouTube</span>
                <span class="video-lessons">{video.videoCount}</span>
              </span>
              <span class="video-title">{info?.title ?? video.guideTitle}</span>
              <span class="video-course">{formatCode(video.code)}</span>
              <span class="video-meta">{video.videoCount} lessons <span aria-hidden="true">→</span></span>
            </a>
          );
        })}
      </div>
      <p><a class="browse-link" href="/brief-history/videos/">All video lessons <span aria-hidden="true">→</span></a></p>
    </section>

    <section class="blogs" aria-labelledby="blogs-heading">
      <div class="section-head">
        <span class="section-index" aria-hidden="true">06</span>
        <h2 class="blogs-heading" id="blogs-heading">Notes</h2>
        <span class="section-rule" aria-hidden="true"></span>
      </div>
      <div class="blogs-grid">
        {posts.map((post) => (
          <article class="blog-card">
            <span class="blog-date">{new Date(post.date).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })}</span>
            <h3 class="blog-title"><a href={`/brief-history/blog/${post.slug}/`}>{post.title}</a></h3>
            <p class="blog-excerpt">{post.excerpt}</p>
            <div class="blog-meta">{post.tags.map((tag) => <span class="blog-tag">{tag}</span>)}</div>
            <a href={`/brief-history/blog/${post.slug}/`} class="blog-link">Read the note <span aria-hidden="true">→</span></a>
          </article>
        ))}
      </div>
      <p><a class="browse-link" href="/brief-history/blog/">All notes <span aria-hidden="true">→</span></a></p>
    </section>
  </div>
</BaseLayout>
