---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
const questions = await getCollection('questions');
const courses = [...new Set(questions.map(q => q.data.course_code))].sort();
---

<BaseLayout title="Home">
  <h1>A Brief History of Past Questions</h1>
  <p>A Project of Theory of Readability</p>
  <p>{questions.length} papers across {courses.length} courses.</p>
  <a href="/brief-history/courses/">Browse courses</a>
</BaseLayout>
