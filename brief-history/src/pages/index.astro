---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { courseSlug } from '@/lib/slug';

const questions = await getCollection('questions');
const courseCount = [...new Set(questions.map(q => q.data.course_code))].length;
const paperCount = questions.length;

// Semester volumes: Volume I-VIII mapped to year/semester
const SEMESTER_GROUPS = [
  { volume: 'I', label: '1st Year 1st Sem', codes: ['1101', '1102', '1103', '1104', '1105'] },
  { volume: 'II', label: '1st Year 2nd Sem', codes: ['1201', '1202', '1203', '1204', '1205', '1206'] },
  { volume: 'III', label: '2nd Year 1st Sem', codes: ['2101', '2102', '2103', '2104', '2105'] },
  { volume: 'IV', label: '2nd Year 2nd Sem', codes: ['2201', '2202', '2203', '2204', '2205', '2206'] },
  { volume: 'V', label: '3rd Year 1st Sem', codes: ['3101', '3102', '3103', '3104', '3105', '3106'] },
  { volume: 'VI', label: '3rd Year 2nd Sem', codes: ['3201', '3202', '3203', '3204', '3205', '3206'] },
  { volume: 'VII', label: '4th Year 1st Sem', codes: ['4101', '4102', '4103', '4104', '4105'] },
  { volume: 'VIII', label: '4th Year 2nd Sem', codes: ['4201', '4202', '4203', '4204', '4205', '4206'] },
];

const semesterVolumes = SEMESTER_GROUPS.map((g) => {
  const papers = questions.filter((q) => g.codes.includes(q.data.course_code.match(/\d+/)?.[0] ?? ''));
  const courses = [...new Set(papers.map((q) => q.data.course_code))].length;
  const paperIds = papers.map((q) => q.id);
  return { ...g, paperCount: papers.length, courseCount: courses, paperIds };
});

// Group volumes by year (4 years × 2 semesters each)
const yearGroups = [
  { label: '1st Year', volumes: semesterVolumes.filter(v => v.volume === 'I' || v.volume === 'II') },
  { label: '2nd Year', volumes: semesterVolumes.filter(v => v.volume === 'III' || v.volume === 'IV') },
  { label: '3rd Year', volumes: semesterVolumes.filter(v => v.volume === 'V' || v.volume === 'VI') },
  { label: '4th Year', volumes: semesterVolumes.filter(v => v.volume === 'VII' || v.volume === 'VIII') },
];

const totalVolPapers = semesterVolumes.reduce((sum, v) => sum + v.paperCount, 0);
const randomQuestion = questions[Math.floor(Math.random() * questions.length)];

// Most papers: top courses by paper count
const coursePaperCounts = new Map();
for (const q of questions) {
  const c = q.data.course_code;
  coursePaperCounts.set(c, (coursePaperCounts.get(c) || 0) + 1);
}
const topCourses = [...coursePaperCounts.entries()]
  .sort(([, a], [, b]) => b - a)
  .slice(0, 5)
  .map(([code, count]) => ({ code, count }));

// Newly added: most recent papers by ID (descending)
const newlyAdded = [...questions].sort((a, b) => b.id.localeCompare(a.id)).slice(0, 5);

// Last updated: use the most recent file modification via ID heuristic
const lastUpdated = new Date().toLocaleDateString('en-BD', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout title="Home">
  <div class="container section">
    <h1 class="home-title">A Brief History of Past Questions</h1>
    <p class="home-subtitle">
      Public, login-free archive of past exam questions for the Department of
      Accounting &amp; Information Systems, University of Barishal.
    </p>

    <form class="search-form" action="/brief-history/browse/" method="GET">
      <label class="search-label" for="search">Search questions</label>
      <input
        id="search"
        name="search"
        class="search-input"
        type="search"
        placeholder="e.g. depreciation, bank reconciliation, AIS 1101&hellip;"
        required
      />
      <button type="submit" class="search-btn">Go to results</button>
    </form>

    <p>
      Or
      <a href="/brief-history/browse/" class="browse-link">browse the full archive</a>
      .
    </p>

    <p class="count-line">
      <strong>{paperCount}</strong> papers across <strong>{courseCount}</strong> courses &middot; <strong>{semesterVolumes.length}</strong> semesters
    </p>

    <section class="semesters" aria-label="Semesters">
      <h2 class="semester-heading">Semesters</h2>
      {yearGroups.map((year) => (
        <div class="year-group">
          <h3 class="year-heading">{year.label}</h3>
          <div class="semester-grid">
            {year.volumes.map((v) => (
              <a
                href={`/brief-history/browse/?course=${v.codes.map(c => `ais ${c}`).join('|')}`}
                class="semester-btn"
                data-volume={v.volume}
                data-total={v.paperCount}
                data-paper-ids={JSON.stringify(v.paperIds)}
                aria-label={`Volume ${v.volume}: ${v.label} — ${v.paperCount} papers across ${v.courseCount} courses`}
              >
                <span class="semester-volume">Volume {v.volume}</span>
                <span class="semester-label">{v.label}</span>
                <span class="semester-count">{v.paperCount} papers</span>
                <svg class="progress-ring" width="28" height="28" viewBox="0 0 28 28" aria-hidden="true">
                  <circle class="progress-ring-bg" cx="14" cy="14" r="11" />
                  <circle class="progress-ring-fill" cx="14" cy="14" r="11" style="stroke-dasharray: 69.1; stroke-dashoffset: 69.1;" />
                </svg>
              </a>
            ))}
          </div>
        </div>
      ))}
    </section>

    <section class="quick-actions" aria-label="Quick actions">
      <h2 class="quick-actions-heading">Quick actions</h2>
      <div class="quick-actions-grid">
        <a
          href={`/brief-history/courses/${courseSlug(randomQuestion.data.course_code)}/${randomQuestion.id}/`}
          class="quick-btn random-btn"
          aria-label="Surprise me — random past question"
        >
          <span class="quick-icon">?</span>
          <span>Surprise me</span>
        </a>
        <a href="/brief-history/browse/" class="quick-btn browse-btn">
          <span class="quick-icon">&rarr;</span>
          <span>Browse all</span>
        </a>
      </div>
    </section>

    <section class="recent-searches" aria-label="Recently searched">
      <h2 class="recent-heading">Recently searched</h2>
      <div class="recent-list" id="recent-list">
        <p class="recent-empty">No recent searches yet.</p>
      </div>
    </section>

    <section class="top-courses" aria-label="Most papers">
      <h2 class="top-heading">Most papers</h2>
      <div class="top-list">
        {topCourses.map((c) => (
          <a
            href={`/brief-history/courses/${courseSlug(c.code)}/`}
            class="top-chip"
            aria-label={c.code + ' — ' + c.count + ' papers'}
          >
            <span class="top-code">{c.code.toUpperCase()}</span>
            <span class="top-count">{c.count} papers</span>
          </a>
        ))}
      </div>
    </section>

    <section class="newly-added" aria-label="Newly added">
      <h2 class="new-heading">Newly added</h2>
      <ul class="new-list">
        {newlyAdded.map((q) => (
          <li class="new-item">
            <a href={`/brief-history/courses/${courseSlug(q.data.course_code)}/${q.id}/`}>
              {q.data.course} &mdash; {q.data.exam}
            </a>
            <span class="new-meta">{q.data.course_code.toUpperCase()} &middot; {q.data.session}</span>
          </li>
        ))}
      </ul>
    </section>

    <div class="home-footer-meta" aria-label="Site metadata">
      <p class="report-link">
        <a href="mailto:abhq@ub.edu.bd?subject=Report%20a%20question">Report a question</a>
      </p>
      <p class="last-updated">Last updated: {lastUpdated}</p>
    </div>
  </div>
</BaseLayout>

<script>
  (function () {
    const STORAGE_KEY = 'abhq:recent-searches';
    const MAX_RECENT = 5;
    const listEl = document.getElementById('recent-list');
    const emptyEl = listEl.querySelector('.recent-empty');

    function load() {
      try {
        return JSON.parse(localStorage.getItem(STORAGE_KEY)) || [];
      } catch { return []; }
    }

    function save(arr) {
      try { localStorage.setItem(STORAGE_KEY, JSON.stringify(arr.slice(0, MAX_RECENT))); } catch {}
    }

    function render() {
      const recent = load();
      listEl.innerHTML = '';
      if (recent.length === 0) {
        listEl.appendChild(emptyEl);
        return;
      }
      recent.forEach((term) => {
        const a = document.createElement('a');
        a.href = '/brief-history/browse/?search=' + encodeURIComponent(term);
        a.className = 'recent-chip';
        a.textContent = term;
        listEl.appendChild(a);
      });
    }

    // Capture searches from the search form on this page
    const form = document.querySelector('.search-form');
    if (form) {
      form.addEventListener('submit', function (e) {
        const input = form.querySelector('input[name="search"]');
        const term = input ? input.value.trim() : '';
        if (!term) return;
        const recent = load().filter((t) => t !== term);
        recent.unshift(term);
        save(recent);
        render();
      });
    }

    render();

    // Progress rings on semester buttons from localStorage
    (function () {
      const READ_PREFIX = 'abhq:read:';
      const buttons = document.querySelectorAll('.semester-btn');
      if (!buttons.length) return;

      buttons.forEach((btn) => {
        const ring = btn.querySelector('.progress-ring-fill');
        if (!ring) return;
        const circumference = 2 * Math.PI * 11;
        let paperIds = [];
        try {
          paperIds = JSON.parse(btn.getAttribute('data-paper-ids') || '[]');
        } catch { paperIds = []; }
        let readCount = 0;
        paperIds.forEach((id) => {
          try {
            if (localStorage.getItem(READ_PREFIX + id) === '1') readCount += 1;
          } catch {}
        });
        const pct = paperIds.length ? readCount / paperIds.length : 0;
        const offset = circumference * (1 - pct);
        ring.style.strokeDashoffset = offset;
        ring.setAttribute('data-pct', Math.round(pct * 100) + '%');
      });
    })();

  })();
</script>
