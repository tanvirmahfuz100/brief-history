---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const questions = await getCollection('questions');
const courseCount = [...new Set(questions.map(q => q.data.course_code))].length;
const paperCount = questions.length;
---

<BaseLayout title="Home">
  <div class="container section">
    <h1 class="home-title">A Brief History of Past Questions</h1>
    <p class="home-subtitle">
      Public, login-free archive of past exam questions for the Department of
      Accounting &amp; Information Systems, University of Barishal.
    </p>

    <form class="search-form" action="/brief-history/browse/" method="GET">
      <label class="search-label" for="search">Search questions</label>
      <input
        id="search"
        name="search"
        class="search-input"
        type="search"
        placeholder="e.g. depreciation, bank reconciliation, AIS 1101&hellip;"
        required
      />
      <button type="submit" class="search-btn">Go to results</button>
    </form>

    <p>
      Or
      <a href="/brief-history/browse/" class="browse-link">browse the full archive</a>
      .
    </p>

    <p class="count-line">
      <strong>{paperCount}</strong> papers across <strong>{courseCount}</strong> courses.
    </p>
  </div>
</BaseLayout>
